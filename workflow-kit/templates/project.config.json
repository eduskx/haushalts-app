{
  "$schema": "./workflow-kit/schemas/project-config.schema.json",
  "project": {
    "name": "CHANGE-ME",
    "language": "en",
    "repo": "OWNER/REPO"
  },
  "tracker": {
    "adapter": "linear",
    "team": "TEAM-KEY",
    "project": "CHANGE-ME",
    "allowedAuthors": ["LINEAR-USER-ID"],
    "statuses": {
      "idea": "Backlog",
      "ready": "Todo",
      "inProgress": "In Progress",
      "done": "Done"
    },
    "labels": {
      "idea": "idea",
      "inReview": "in-review",
      "needsHuman": "needs-human",
      "humanTask": "human-task",
      "humanReview": "human-review",
      "ui": "ui"
    },
    "sections": {
      "questions": "Open questions",
      "answers": "Answers"
    }
  },
  "commands": {
    "install": "pnpm install --frozen-lockfile",
    "check": "pnpm check",
    "e2e": "pnpm e2e",
    "preview": "pnpm preview"
  },
  "models": {
    "planner": { "model": "opus", "fallback": "sonnet" },
    "implementer": { "model": "sonnet" },
    "reviewer": { "model": "sonnet" },
    "tester": { "model": "sonnet" },
    "auditor": { "model": "opus", "fallback": "sonnet" }
  },
  "limits": {
    "maxDiffLines": 300,
    "maxFixRounds": 2,
    "auditEveryMerges": 10
  },
  "protectedPaths": [".github/", "workflow-kit/", "project.config.json", "CLAUDE.md"],
  "destructiveSql": ["\\bdrop\\s+(table|column|schema)\\b", "\\btruncate\\b", "\\bdisable\\s+row\\s+level\\s+security\\b"],
  "forbiddenTerms": {
    "paths": ["packages/"],
    "terms": []
  },
  "docs": {
    "spec": "docs/specs/v1.md",
    "moduleContract": "docs/module-contract.md",
    "adrDir": "docs/adr/"
  }
}
