{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verdict",
  "description": "Returned by the reviewer and tester. The orchestrator acts on it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "criteria", "findings"],
  "properties": {
    "verdict": { "enum": ["approve", "changes_requested", "needs_human"] },
    "summary": { "type": "string" },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status"],
        "properties": {
          "criterion": { "type": "string" },
          "status": { "enum": ["passed", "failed", "not_run"] },
          "note": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "problem", "scenario"],
        "properties": {
          "severity": { "enum": ["blocker", "major", "minor"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "problem": { "type": "string" },
          "scenario": { "type": "string", "description": "The input or state that makes it go wrong." }
        }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}
