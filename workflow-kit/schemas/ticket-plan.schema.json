{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TicketPlan",
  "description": "Returned by the planner and auditor. The orchestrator turns it into tracker tickets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tickets", "openQuestions"],
  "properties": {
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "module", "goal", "criteria", "labels", "dependsOn", "needsHuman"],
        "properties": {
          "id": { "type": "string", "description": "Local id, used only by dependsOn." },
          "title": { "type": "string" },
          "module": { "type": "string" },
          "goal": { "type": "string" },
          "criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "labels": { "type": "array", "items": { "type": "string" } },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "needsHuman": { "type": "boolean" }
        }
      }
    },
    "openQuestions": { "type": "array", "items": { "type": "string" } }
  }
}
